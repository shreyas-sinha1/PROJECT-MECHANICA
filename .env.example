# Mechanica AI Intelligence Layer Multi-Provider Configuration
# Active Provider: 'tinfoil' (primary) or 'gemini' (secondary)
AI_PROVIDER=tinfoil

# Tinfoil AI (Primary)
# Get your API key from https://tinfoil.sh
TINFOIL_API_KEY=your_tinfoil_api_key_here
# Optional Tinfoil overrides (defaults to deepseek-v4-1-flash and https://inference.tinfoil.sh/v1)
# TINFOIL_MODEL=deepseek-v4-1-flash
# TINFOIL_BASE_URL=https://inference.tinfoil.sh/v1

# Google Gemini (Secondary)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini model override (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
